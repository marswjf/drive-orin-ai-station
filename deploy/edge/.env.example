# IECU 边缘入口的发布模板。复制为 .env 填入自己的值。
# ⚠ FRP token 用独立随机值，不要与管理密码相同；两者分开生成。
# 生成 token：openssl rand -hex 32

# ── Caddy / 公网入口 ──────────────────────────────────────────
# 面板对外的主机与端口。证书在 HOST 上终止（板子够不到 Let's Encrypt）。
IECU_PUBLIC_HOST=panel.example.com
IECU_PUBLIC_PORT=9000
# 证书绝对路径。Caddy 会自动续期。
IECU_TLS_CERT=/etc/caddy/certs/panel.example.com.crt
IECU_TLS_KEY=/etc/caddy/certs/panel.example.com.key
# 证书目录，挂进容器 /certs。上面两个值的目录与此一致即可。
IECU_TLS_DIR=/etc/caddy/certs
# 板子在家网时的局域网面板地址（隧道不通时的直连上游）。用测试网段。
IECU_PANEL_LAN_ADDR=192.0.2.15:9000

# ── FRPS ──────────────────────────────────────────────────────
# frps 绑定端口（板子的 frpc 从这里接进来），以及面板隧道在 frps 侧的端口。
# 转发到板子的面板时，Caddy 用它做上游。
IECU_FRPS_BIND_PORT=7000
IECU_FRP_PANEL_PORT=7001
IECU_FRP_TOKEN=__SET_RANDOM_TOKEN__

# frps 管理界面（可选，默认不暴露到公网）。
IECU_FRP_DASHBOARD_PORT=7500
IECU_FRP_DASHBOARD_USER=admin
IECU_FRP_DASHBOARD_PASS=__SET_RANDOM_PASS__
