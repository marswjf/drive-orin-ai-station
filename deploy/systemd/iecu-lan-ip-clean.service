[Unit]
Description=IECU 局域网静态地址 (__BOARD_LAN_IP__ 与 192.168.0.201 on eth.254)
# tn_eth_init 是厂商创建 VLAN 子接口的脚本，必须等它跑完
After=network.target nv_tacp_init.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/var/lib/llm/net/set-lan-ip.sh
# 停服务时只撤销自己加的两个地址，不碰厂商配的 172.31.254.38
ExecStop=-/sbin/ip addr del __BOARD_LAN_IP__/24 dev eth.254
ExecStop=-/sbin/ip addr del 192.168.0.201/24 dev eth.254
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
