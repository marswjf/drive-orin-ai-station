[Unit]
Description=ComfyUI (图像/视频生成)
After=network-online.target
Wants=network-online.target
# 只与"大块头"互斥：智驾栈占 11 GB，对话模型光权重就占 20 GB，
# 和生图模型不可能共存。
#
# ⚠ 故意不与 llm-embedding 互斥：向量服务是基础设施，多数时候要常驻，
# 而它走 CPU 档时 GPU 映射内存为零、进程内存约 1.3 GB，生图完全容得下。
# 需要腾出这 1.3 GB 时（跑大的生图/视频模型），由面板显式停它，
# 不靠 systemd 自动踢掉——否则用户每次切生图都会把向量库打断。
Conflicts=application_start.service llm-server.service

[Service]
Type=simple
# 2026-08-15 切到 Python 3.13 环境（自编 torch 2.11.0 / torchvision 0.26.0 / torchaudio 2.11.0，
# CUDA 12.2 Tegra 变体 sm_87，cuDNN 9.20，OpenBLAS 0.3.29，**Flash Attention 开启**）。
# 上一代 py3.10 环境 /var/lib/llm/comfyui310 原样保留作回滚，
# 回滚就是把下面两行的 comfyui313 改回 comfyui310 并删掉 ExecStartPre
# （回滚步骤见 deploy/torch-py313/ 的切换说明）。
#
# ★ ExecStartPre 是新栈必需的：实体在 /opt/m0（/var 只有 20G 装不下第二套），
#   bind 回 /var/lib/llm 之后必须 remount 去掉 noexec，否则 .so 加载失败。
#   脚本幂等，重复执行无副作用。
ExecStartPre=/var/lib/llm/mount-stack313.sh
WorkingDirectory=/var/lib/llm/comfyui313
# ★ --highvram 不是"因为显存大所以奢侈"，恰恰相反：这块板子上它是必需的。
#   统一内存下 ComfyUI 的 offload 省不出一个字节（A-118），但搬运动作是真实开销——
#   Z-Image 走默认策略每步要把 6.3 GB 权重逐层搬回来，13.79 秒/步；
#   改成全常驻后 5.01 秒/步，快 2.75 倍且能连续出图（A-124）。
#   ⚠ NORMAL_VRAM（不写这个参数）同样会 OOM：ComfyUI 仍按"能 offload"算账，会算错。
#   代价：模型总量必须 ≤14 GB 左右。超了就换更低的量化档，不要退回 offload。
#   ⚠ 新栈有了 Flash Attention，注意力的峰值内存大幅下降，但这不改变权重常驻的账，
#     ≤14 GB 的约束依旧成立。
ExecStart=/var/lib/llm/comfyui313/run.sh --listen 0.0.0.0 --port 8188 --highvram --disable-smart-memory
TimeoutStartSec=900
TimeoutStopSec=120
Restart=on-failure
RestartSec=15
LimitNOFILE=65536
# 内存吃紧时优先牺牲它，保住面板（面板是 -800）
OOMScoreAdjust=200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
